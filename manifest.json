{
  "manifest_version": 3,
  "name": "Spotify Quiet",
  "version": "0.1.0",
  "description": "Spotify ad blocker. Simple on/off switch.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "scripting", "declarativeNetRequest"],
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://*.spotify.com/*",
    "https://*.scdn.co/*",
    "https://*.spotifycdn.com/*",
    "https://*.akamaized.net/*",
    "https://*.amillionads.com/*",
    "https://*.2mdn.net/*",
    "https://*.adxcel.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "declarative_net_request": {
    "rule_resources": [{ "id": "ad_audio", "enabled": true, "path": "rules.json" }]
  },
  "web_accessible_resources": [
    { "resources": ["silence.mp4"], "matches": ["https://open.spotify.com/*"] }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Spotify Quiet" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
